# ---- Voice (local Pipecat server — see docs/voice-integration-spec.md) ----
# Browser WS target. Use wss://<LAN-IP>:6001/... when serving the site over HTTPS.
VOICE_WS_URL=ws://localhost:6001/api/voice/ws
VOICE_WS_HOST=0.0.0.0
VOICE_WS_PORT=6001
# VOICE_WS_TLS_CERT=/path/cert.pem      # set both for WSS (LAN/Tailscale)
# VOICE_WS_TLS_KEY=/path/key.pem
VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6000
# STT engine: moonshine (default, local ONNX, no API key) or whisper (faster-whisper base/int8)
STT_ENGINE=moonshine
MOONSHINE_MODEL=small-streaming
WHISPER_MODEL=base
KOKORO_VOICE=af_heart
# LLM generation tuning (DeepSeek voice brain)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=300
# Silero VAD tuning (defaults match pipecat's built-in behavior)
VOICE_VAD_CONFIDENCE=0.7
VOICE_VAD_START_SECS=0.2
VOICE_VAD_STOP_SECS=0.2
VOICE_VAD_MIN_VOLUME=0.6
# Tool-activity filler speech (ack / heartbeat / live pi narration). OFF by default:
# the agent stays silent while tools run, so you never hear a tool call announced.
# Set to 1 to re-enable the old narrate-first pacing.
# VOICE_ANNOUNCE_TOOLS=0
# G5 latency guard: max estimated tokens for the serialized hot voice-prefill schema
# block. Heavy plan/worktree schemas are lazy-injected behind the orchestrator, so the
# always-hot toolset stays small. Raise only if the hot toolset legitimately grows.
# VOICE_SCHEMA_TOKEN_BUDGET=1800

# ---- Site server (server.py) ----
# PORT=8444                 # LAN production (browser-safe; 6000 is blocked by
#                           # Chromium/Safari as an unsafe X11 port). Default 3000 (dev/tests).
# TLS_CERT=/path/cert.pem
# TLS_KEY=/path/key.pem

# ---- DeepSeek (required for /api/summon spec synthesis + voice brain) ----
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Removed ----
# OPENAI_API_KEY no longer required (was only used by the Realtime voice leg).
